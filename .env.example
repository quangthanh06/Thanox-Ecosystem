# ============================================================================
# THANOX STORE — BIẾN MÔI TRƯỜNG MẪU
# ⚠️ KHÔNG BAO GIỜ điền giá trị thật vào file này (file này lên GitHub).
#    Giá trị thật chỉ đặt trong .env (local) và Settings trên Vercel.
# ============================================================================

# ---- SUPABASE ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # CHỈ đặt trên Vercel serverless, không prefix VITE_

# ---- THUEAPIBANK (PROVIDER CHÍNH — MB Bank qua THUEAPI) ----
# Webhook nhận giao dịch: POST /api/webhook/mbbank
# Header: signature: <MBBANK_SECRET_KEY>  (hoặc Authorization: Bearer <key>)
MBBANK_SECRET_KEY=
THUEAPI_MB_TOKEN=                 # token lấy từ thueapi.vn (đã đổi mới sau lộ token cũ)
THUEAPI_TEST_MODE=0
THUEAPI_POLL_INTERVAL=5

# ---- Ngân hàng hiển thị VietQR cho khách ----
BANK_NAME=MB Bank
BANK_CODE=MB
BANK_ACCOUNT=
BANK_HOLDER=

# ---- SEPAY (LEGACY — chỉ giữ tương thích cũ, KHÔNG dùng cho production) ----
SEPAY_API_KEY=

# ---- LIÊN HỆ / MISC ----
CONTACT_TELEGRAM=
CONTACT_ZALO=
SHOP_NAME=THANOXSTORE
BOT_USERNAME=
VITE_APP_URL=
APP_URL=
GEMINI_API_KEY=
