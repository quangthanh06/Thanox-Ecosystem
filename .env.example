# ============================================================================
# THANOX STORE — BIẾN MÔI TRƯỜNG MẪU
# ⚠️ KHÔNG điền giá trị thật vào file này (file lên GitHub). Giá trị thật chỉ
#    đặt trong .env (local) và Vercel Project Settings → Environment Variables.
# ============================================================================

# ---- SUPABASE ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # chỉ trên Vercel serverless, không có prefix VITE_

# ---- THUEAPIBANK (PROVIDER CHÍNH — MB Bank qua THUEAPI) ----
# Webhook nhận giao dịch: POST /api/webhook/mbbank (header: signature)
THUEAPIBANK_SECRET_KEY=             # secret xác thực webhook (server-side only)
MBBANK_SECRET_KEY=                  # tên cũ tương thích — nếu đặt, THUEAPIBANK_SECRET_KEY được ưu tiên
THUEAPI_MB_TOKEN=                   # token đã ROTATE mới (token cũ b7872a... đã lộ, tuyệt đối không dùng)
THUEAPIBANK_HISTORY_URL=https://thueapibank.vn/historyapimbv2   # theo spec GET history

# ---- RECONCILIATION CRON ----
# Vercel Cron tự gửi: Authorization: Bearer $CRON_SECRET → /api/cron/reconcile-thueapibank
CRON_SECRET=

# ---- Ngân hàng hiển thị VietQR cho khách ----
BANK_NAME=MB Bank
BANK_CODE=MB
BANK_ACCOUNT=
BANK_HOLDER=

# ---- SEPAY (LEGACY — chỉ tương thích cũ, KHÔNG dùng production) ----
SEPAY_API_KEY=

# ---- LIÊN HỆ / MISC ----
CONTACT_TELEGRAM=
CONTACT_ZALO=
SHOP_NAME=THANOXSTORE
BOT_USERNAME=
VITE_APP_URL=
APP_URL=
GEMINI_API_KEY=
