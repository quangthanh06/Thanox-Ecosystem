# ============================================================================
# THANOX STORE - ENVIRONMENT VARIABLES EXAMPLE
# Tuyệt đối KHÔNG điền giá trị secret thật vào file này (.env.example).
# Giá trị thật chỉ đặt trong .env (local) và Vercel Project Settings -> Environment Variables.
# ============================================================================

# ---- SUPABASE (DATABASE & AUTH) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key   # Server-side ONLY (BẮT BUỘC cho Webhook / API)

# ---- SEPAY (PRIMARY PRODUCTION PAYMENT GATEWAY) ----
# Webhook URL SePay Dashboard: https://thanoxstorebot.shop/api/webhook/sepay
# Header: Authorization: Bearer <SEPAY_API_KEY> hoặc Apikey <SEPAY_API_KEY>
SEPAY_API_KEY=your_sepay_api_key_here

# ---- THÔNG TIN TÀI KHOẢN NGÂN HÀNG (HIỂN THỊ VIETQR CHO KHÁCH) ----
BANK_NAME=MB Bank
BANK_CODE=MB
BANK_ACCOUNT=0123456789
BANK_HOLDER=NGUYEN VAN A

# ---- THUEAPIBANK (COMPATIBILITY / LEGACY - TÙY CHỌN) ----
THUEAPIBANK_SECRET_KEY=
THUEAPI_MB_TOKEN=
THUEAPIBANK_HISTORY_URL=https://thueapibank.vn/historyapimbv2
CRON_SECRET=

# ---- THÔNG TIN SHOP / SOCIAL / MISC ----
SHOP_NAME=THANOXSTORE
CONTACT_TELEGRAM=
CONTACT_ZALO=
BOT_USERNAME=
VITE_APP_URL=https://thanoxstorebot.shop
APP_URL=https://thanoxstorebot.shop
